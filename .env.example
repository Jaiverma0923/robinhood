# Platform fee (testnet-only) — see README "Testnet platform fee" section.
#
# Nothing here is secret: the fee transaction is signed by the user's own
# connected wallet, not by this server. Do NOT put a private key, signing
# secret, or an RPC URL containing a sensitive API key you're not willing to
# expose in here without care — TESTNET_RPC_URL is read server-side only and
# never sent to the browser, but it's still worth using a low-privilege,
# rate-limited testnet endpoint (e.g. a free-tier Infura/Alchemy/public RPC).

# Fee, in basis points. 50 = 0.50%.
PLATFORM_FEE_BPS=50

# ERC-20 token used to pay the platform fee. Must be a TESTNET token address.
PLATFORM_FEE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
PLATFORM_FEE_TOKEN_SYMBOL=TEST
PLATFORM_FEE_TOKEN_DECIMALS=18

# Where collected fees are sent. Must be an address you control on the same
# testnet.
PLATFORM_FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000

# Server-side only — used to independently verify a submitted fee
# transaction before crediting a trade as executed. Never exposed to the
# client. Leave unset to skip server-side verification (the client's wallet
# provider is still the one confirming the transaction).
TESTNET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chain id of the testnet above. 11155111 = Sepolia. The app refuses to
# start the fee flow if this resolves to a known mainnet chain id.
TESTNET_CHAIN_ID=11155111
TESTNET_CHAIN_NAME=Sepolia
# Optional — inferred for well-known testnets if omitted.
TESTNET_BLOCK_EXPLORER_BASE=https://sepolia.etherscan.io
